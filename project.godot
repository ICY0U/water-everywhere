; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WaterEVERYWHERE"
config/description="Water EveryWhere: a cooperative raft voyage across a cel-shaded ocean."
config/version="0.9.0"
run/main_scene="res://scenes/voyage.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.122, 0.18, 1)
boot_splash/image="res://assets/boot_splash.png"
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[autoload]

NetworkSession="*res://scripts/network/network_session.gd"
Settings="*res://scripts/core/settings.gd"
Audio="*res://scripts/audio/audio_director.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

